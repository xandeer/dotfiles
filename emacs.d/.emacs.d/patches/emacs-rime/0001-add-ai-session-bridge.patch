+emacs_value
+set_property(emacs_env *env, ptrdiff_t nargs, emacs_value *args, void *data) {
+  EmacsRime *rime = (EmacsRime*) data;
+
+  if (!rime->session_id || !RIME_API_AVAILABLE(rime->api, set_property)) {
+    return nil;
+  }
+
+  char *name = get_string(env, args[0]);
+  char *value = get_string(env, args[1]);
+  if (!name || !value) {
+    free(name);
+    free(value);
+    return nil;
+  }
+
+  rime->api->set_property(rime->session_id, name, value);
+  free(name);
+  free(value);
+  return t;
+}
+
+emacs_value
+get_current_schema(emacs_env *env, ptrdiff_t nargs, emacs_value *args, void *data) {
+  EmacsRime *rime = (EmacsRime*) data;
+
+  if (!rime->session_id || !RIME_API_AVAILABLE(rime->api, get_current_schema)) {
+    return nil;
+  }
+
+  char schema_id[256] = {0};
+  if (!rime->api->get_current_schema(rime->session_id,
+                                     schema_id,
+                                     sizeof(schema_id))) {
+    return nil;
+  }
+  schema_id[sizeof(schema_id) - 1] = '\0';
+  return STRING(schema_id);
+}
+
+emacs_value
+user_config_get_string(emacs_env *env,
+                       ptrdiff_t nargs,
+                       emacs_value *args,
+                       void *data) {
+  EmacsRime *rime = (EmacsRime*) data;
+
+  if (!RIME_API_AVAILABLE(rime->api, user_config_open) ||
+      !RIME_API_AVAILABLE(rime->api, config_get_cstring) ||
+      !RIME_API_AVAILABLE(rime->api, config_close)) {
+    return nil;
+  }
+
+  char *config_id = get_string(env, args[0]);
+  char *key = get_string(env, args[1]);
+  if (!config_id || !key) {
+    free(config_id);
+    free(key);
+    return nil;
+  }
+
+  RimeConfig config = {0};
+  if (!rime->api->user_config_open(config_id, &config)) {
+    free(config_id);
+    free(key);
+    return nil;
+  }
+
+  const char *value = rime->api->config_get_cstring(&config, key);
+  emacs_value result = value ? STRING(value) : nil;
+  rime->api->config_close(&config);
+  free(config_id);
+  free(key);
+  return result;
+}
+
+emacs_value
+user_config_get_bool(emacs_env *env,
+                     ptrdiff_t nargs,
+                     emacs_value *args,
+                     void *data) {
+  EmacsRime *rime = (EmacsRime*) data;
+  emacs_value default_value = env->is_not_nil(env, args[2]) ? t : nil;
+
+  if (!RIME_API_AVAILABLE(rime->api, user_config_open) ||
+      !RIME_API_AVAILABLE(rime->api, config_get_bool) ||
+      !RIME_API_AVAILABLE(rime->api, config_close)) {
+    return default_value;
+  }
+
+  char *config_id = get_string(env, args[0]);
+  char *key = get_string(env, args[1]);
+  if (!config_id || !key) {
+    free(config_id);
+    free(key);
+    return default_value;
+  }
+
+  RimeConfig config = {0};
+  if (!rime->api->user_config_open(config_id, &config)) {
+    free(config_id);
+    free(key);
+    return default_value;
+  }
+
+  Bool value;
+  emacs_value result = rime->api->config_get_bool(&config, key, &value)
+    ? (value ? t : nil)
+    : default_value;
+  rime->api->config_close(&config);
+  free(config_id);
+  free(key);
+  return result;
+}
