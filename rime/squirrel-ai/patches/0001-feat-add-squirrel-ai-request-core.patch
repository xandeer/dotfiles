+++ b/sources/SquirrelAI.swift
@@ -0,0 +1,203 @@
+import Foundation
+import LocalAuthentication
+import Security
+
+struct SquirrelAISnapshot: Equatable {
+  let session: UInt64
+  let generation: UInt64
+  let schema: String
+  let input: String
+  let caret: Int
+  let clientID: String
+  let appID: String
+  let candidates: [String]
+  let recentCommits: [String]
+  let surroundingBefore: String
+  let surroundingAfter: String
+}
+
+struct SquirrelAISurroundingRanges: Equatable {
+  let before: NSRange
+  let after: NSRange
+}
+
+struct SquirrelAIHistory {
+  private(set) var commits: [String] = []
+  private var secureTainted = false
+
+  mutating func observeSecureInput() {
+    commits.removeAll()
+    secureTainted = true
+  }
+
+  mutating func beginNormalComposition() {
+    guard secureTainted else { return }
+    commits.removeAll()
+    secureTainted = false
+  }
+
+  mutating func recordCommit(_ value: String, secure: Bool) {
+    if secure {
+      observeSecureInput()
+      return
+    }
+    guard !secureTainted, !value.isEmpty else { return }
+    commits.append(String(value.prefix(128)))
+    if commits.count > 5 {
+      commits.removeFirst(commits.count - 5)
+    }
+  }
+}
+
+enum SquirrelAI {
+  static let keychainService = "im.rime.inputmethod.Squirrel.ai"
+  static let keychainAccount = "default"
+
+  static func surroundingRanges(
+    documentUTF16Length: Int,
+    markedRange: NSRange,
+    selectedRange: NSRange
+  ) -> SquirrelAISurroundingRanges? {
+    guard documentUTF16Length >= 0 else { return nil }
+
+    let center: NSRange
+    if markedRange.location == NSNotFound {
+      guard selectedRange.length == 0,
+            valid(selectedRange, in: documentUTF16Length) else { return nil }
+      center = selectedRange
+    } else {
+      guard valid(markedRange, in: documentUTF16Length) else { return nil }
+      center = markedRange
+    }
+
+    let end = center.location + center.length
+    let beforeLength = min(128, center.location)
+    let afterLength = min(128, documentUTF16Length - end)
+    return SquirrelAISurroundingRanges(
+      before: NSRange(location: center.location - beforeLength, length: beforeLength),
+      after: NSRange(location: end, length: afterLength)
+    )
+  }
+
+  static func endpoint(_ raw: String) -> URL? {
+    guard raw == raw.trimmingCharacters(in: .whitespacesAndNewlines),
+          let components = URLComponents(string: raw),
+          components.scheme?.lowercased() == "https",
+          let host = components.host,
+          !host.isEmpty,
+          components.user == nil,
+          components.password == nil else { return nil }
+    return components.url
+  }
+
+  static func request(
+    endpoint: URL,
+    key: String,
+    model: String,
+    snapshot: SquirrelAISnapshot
+  ) -> URLRequest? {
+    guard self.endpoint(endpoint.absoluteString) != nil,
+          !key.isEmpty,
+          !key.unicodeScalars.contains(where: { $0.properties.generalCategory == .control }),
+          !model.isEmpty,
+          let promptData = try? JSONEncoder().encode(SquirrelAIPrompt(snapshot)),
+          let prompt = String(data: promptData, encoding: .utf8),
+          let body = try? JSONEncoder().encode(SquirrelAIRequest(
+            model: model,
+            messages: [
+              SquirrelAIMessage(
+                role: "system",
+                content: "Choose an existing candidate when possible; only otherwise create one new candidate. Return exactly one JSON object and nothing else: {\"candidate\":\"...\"}. Candidate must be one line of at most 64 characters."
+              ),
+              SquirrelAIMessage(role: "user", content: prompt),
+            ],
+            stream: false
+          )) else { return nil }
+
+    var request = URLRequest(url: endpoint)
+    request.httpMethod = "POST"
+    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+    request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+    request.httpBody = body
+    return request
+  }
+
+  static func parseCandidate(from data: Data) -> String? {
+    guard let outer = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+          let choices = outer["choices"] as? [[String: Any]],
+          choices.count == 1,
+          let first = choices.first,
+          let message = first["message"] as? [String: Any],
+          let content = message["content"] as? String,
+          let innerData = content.data(using: .utf8),
+          let inner = try? JSONSerialization.jsonObject(with: innerData) as? [String: Any],
+          Set(inner.keys) == Set(["candidate"]),
+          let candidate = inner["candidate"] as? String,
+          !candidate.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+          candidate.count <= 64,
+          !candidate.contains(where: { $0.isNewline }),
+          !candidate.unicodeScalars.contains(where: { $0.properties.generalCategory == .control }) else {
+      return nil
+    }
+    return candidate
+  }
+
+  static func readAPIKey(
+    service: String = keychainService,
+    account: String = keychainAccount
+  ) -> String? {
+    let context = LAContext()
+    context.interactionNotAllowed = true
+    let query: [CFString: Any] = [
+      kSecClass: kSecClassGenericPassword,
+      kSecAttrService: service,
+      kSecAttrAccount: account,
+      kSecMatchLimit: kSecMatchLimitOne,
+      kSecReturnData: true,
+      kSecUseAuthenticationContext: context,
+    ]
+    var result: CFTypeRef?
+    guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess,
+          let data = result as? Data,
+          let key = String(data: data, encoding: .utf8),
+          !key.isEmpty else { return nil }
+    return key
+  }
+
+  private static func valid(_ range: NSRange, in documentLength: Int) -> Bool {
+    range.location != NSNotFound &&
+      range.location >= 0 &&
+      range.length >= 0 &&
+      range.location <= documentLength &&
+      range.length <= documentLength - range.location
+  }
+}
+
+private struct SquirrelAIMessage: Encodable {
+  let role: String
+  let content: String
+}
+
+private struct SquirrelAIRequest: Encodable {
+  let model: String
+  let messages: [SquirrelAIMessage]
+  let stream: Bool
+}
+
+private struct SquirrelAIPrompt: Encodable {
+  let schema: String
+  let input: String
+  let candidates: [String]
+  let recentCommits: [String]
+  let surroundingBefore: String
+  let surroundingAfter: String
+
+  init(_ snapshot: SquirrelAISnapshot) {
+    schema = snapshot.schema
+    input = snapshot.input
+    candidates = snapshot.candidates
+    recentCommits = snapshot.recentCommits
+    surroundingBefore = snapshot.surroundingBefore
+    surroundingAfter = snapshot.surroundingAfter
+  }
+}
