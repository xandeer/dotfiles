+  func aiPrefixUTF16(_ value: String) -> String {
+    let value = value as NSString
+    var length = min(value.length, 128)
+    if length < value.length,
+       length > 0,
+       (0xD800...0xDBFF).contains(Int(value.character(at: length - 1))) {
+      length -= 1
+    }
+    return value.substring(with: NSRange(location: 0, length: length))
+  }
+
+  func aiSuffixUTF16(_ value: String) -> String {
+    let value = value as NSString
+    var location = max(0, value.length - 128)
+    if location > 0,
+       location < value.length,
+       (0xDC00...0xDFFF).contains(Int(value.character(at: location))) {
+      location += 1
+    }
+    return value.substring(with: NSRange(location: location, length: value.length - location))
+  }
+
+  func currentAISnapshot(generation: UInt64) -> SquirrelAISnapshot? {
+    guard session != 0,
+          rimeAPI.find_session(session),
+          let client,
+          let inputPointer = rimeAPI.get_input(session) else { return nil }
+    let input = String(cString: inputPointer)
+    guard !input.isEmpty, input.count <= 64 else { return nil }
+
+    let selectedRange = client.selectedRange()
+    let markedRange = client.markedRange()
+    let documentLength = client.length()
+    var surroundingBefore = ""
+    var surroundingAfter = ""
+    if let ranges = SquirrelAI.surroundingRanges(
+      documentUTF16Length: documentLength,
+      markedRange: markedRange,
+      selectedRange: selectedRange
+    ),
+      let before = client.attributedSubstring(from: ranges.before)?.string,
+      let after = client.attributedSubstring(from: ranges.after)?.string {
+      surroundingBefore = aiSuffixUTF16(before)
+      surroundingAfter = aiPrefixUTF16(after)
+    }
+
+    return SquirrelAISnapshot(
+      session: UInt64(session),
+      generation: generation,
+      schema: schemaId,
+      input: input,
+      caret: Int(rimeAPI.get_caret_pos(session)),
+      clientID: client.uniqueClientIdentifierString(),
+      appID: currentApp,
+      candidates: aiCandidates.prefix(8).map { String($0.prefix(64)) },
+      recentCommits: aiHistory.commits,
+      surroundingBefore: surroundingBefore,
+      surroundingAfter: surroundingAfter
+    )
+  }
+
+  func currentAIRuntimeConfiguration() -> SquirrelAIRuntimeConfiguration? {
+    let enabled = NSApp.squirrelAppDelegate.config?.getBool("ai/enabled") ?? true
+    guard enabled else { return nil }
+    guard let endpointText = NSApp.squirrelAppDelegate.config?.getString("ai/endpoint"),
+          let endpoint = SquirrelAI.endpoint(endpointText),
+          let model = NSApp.squirrelAppDelegate.config?.getString("ai/model"),
+          !model.isEmpty,
+          model == model.trimmingCharacters(in: .whitespacesAndNewlines),
+          let instructions = SquirrelAI.instructions(
+            NSApp.squirrelAppDelegate.config?.getString("ai/instructions") ?? ""
+          ) else { return nil }
+    return SquirrelAIRuntimeConfiguration(
+      enabled: enabled,
+      endpoint: endpoint,
+      model: model,
+      instructions: instructions
+    )
+  }
