+private final class SquirrelAIURLSessionDelegate: NSObject, URLSessionDataDelegate {
+  private struct Pending {
+    let expectedURL: URL
+    let completion: (Data?) -> Void
+    var data = Data()
+  }
+
+  private let lock = NSLock()
+  private var responses: [Int: Pending] = [:]
+
+  func register(
+    _ dataTask: URLSessionDataTask,
+    expectedURL: URL,
+    completion: @escaping (Data?) -> Void
+  ) {
+    lock.lock()
+    responses[dataTask.taskIdentifier] = Pending(expectedURL: expectedURL, completion: completion)
+    lock.unlock()
+  }
+
+  func urlSession(
+    _: URLSession,
+    task _: URLSessionTask,
+    willPerformHTTPRedirection _: HTTPURLResponse,
+    newRequest _: URLRequest,
+    completionHandler: @escaping (URLRequest?) -> Void
+  ) {
+    completionHandler(nil)
+  }
+
+  func urlSession(
+    _: URLSession,
+    dataTask: URLSessionDataTask,
+    didReceive response: URLResponse,
+    completionHandler: @escaping (URLSession.ResponseDisposition) -> Void
+  ) {
+    lock.lock()
+    let pending = responses[dataTask.taskIdentifier]
+    let allowed = pending.map {
+      guard let response = response as? HTTPURLResponse else { return false }
+      return response.url == $0.expectedURL && (200..<300).contains(response.statusCode)
+    } ?? false
+    if !allowed {
+      responses.removeValue(forKey: dataTask.taskIdentifier)
+    }
+    lock.unlock()
+    completionHandler(allowed ? .allow : .cancel)
+  }
+
+  func urlSession(_: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+    var shouldCancel = false
+    lock.lock()
+    if var pending = responses[dataTask.taskIdentifier] {
+      if data.count <= 65_536 - pending.data.count {
+        pending.data.append(data)
+        responses[dataTask.taskIdentifier] = pending
+      } else {
+        responses.removeValue(forKey: dataTask.taskIdentifier)
+        shouldCancel = true
+      }
+    }
+    lock.unlock()
+    if shouldCancel {
+      dataTask.cancel()
+    }
+  }
+
+  func urlSession(
+    _: URLSession,
+    task: URLSessionTask,
+    didCompleteWithError error: Error?
+  ) {
+    lock.lock()
+    let pending = responses.removeValue(forKey: task.taskIdentifier)
+    lock.unlock()
+    guard let pending,
+          error == nil,
+          let response = task.response as? HTTPURLResponse,
+          response.url == pending.expectedURL,
+          (200..<300).contains(response.statusCode) else {
+      pending?.completion(nil)
+      return
+    }
+    pending.completion(pending.data)
+  }
+}
+
+private struct SquirrelAIRuntimeConfiguration: Equatable {
+  let enabled: Bool
+  let endpoint: URL
+  let model: String
+  let instructions: String
+}
