+  func scheduleAICandidate() {
+    guard session != 0, rimeAPI.find_session(session) else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    if IsSecureEventInputEnabled() {
+      aiHistory.observeSecureInput()
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    guard let configuration = currentAIRuntimeConfiguration() else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    guard let inputPointer = rimeAPI.get_input(session) else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    let input = String(cString: inputPointer)
+    guard !input.isEmpty, input.count <= 64 else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+
+    aiHistory.beginNormalComposition()
+    if let snapshot = aiSnapshot,
+       currentAISnapshot(generation: snapshot.generation) == snapshot,
+       aiDebounceTimer?.isValid == true || aiTask?.state == .running {
+      return
+    }
+
+    invalidateAICandidate(clearProperties: false)
+    guard let snapshot = currentAISnapshot(generation: aiGeneration) else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    aiSnapshot = snapshot
+    aiDebounceTimer = Timer.scheduledTimer(withTimeInterval: 0.3, repeats: false) { [weak self] _ in
+      guard let self else { return }
+      if IsSecureEventInputEnabled() {
+        self.aiHistory.observeSecureInput()
+        self.invalidateAICandidate(clearProperties: true)
+        return
+      }
+      guard self.ownsAICandidate(snapshot) else { return }
+      self.aiDebounceTimer = nil
+      guard self.currentAISnapshot(generation: snapshot.generation) == snapshot,
+            self.currentAIRuntimeConfiguration() == configuration else {
+        self.invalidateAICandidate(clearProperties: true)
+        return
+      }
+
+      self.aiKeychainQueue.async { [weak self] in
+        guard self != nil else { return }
+        let key = SquirrelAI.readAPIKey()
+        DispatchQueue.main.async { [weak self] in
+          guard let self else { return }
+          if IsSecureEventInputEnabled() {
+            self.aiHistory.observeSecureInput()
+            self.invalidateAICandidate(clearProperties: true)
+            return
+          }
+          guard self.ownsAICandidate(snapshot) else { return }
+          guard let key,
+                self.currentAISnapshot(generation: snapshot.generation) == snapshot,
+                self.currentAIRuntimeConfiguration() == configuration,
+                let request = SquirrelAI.request(
+                  endpoint: configuration.endpoint,
+                  key: key,
+                  model: configuration.model,
+                  instructions: configuration.instructions,
+                  snapshot: snapshot
+                ),
+                let requestURL = request.url else {
+            self.invalidateAICandidate(clearProperties: true)
+            return
+          }
+
+          let task = self.aiURLSession.dataTask(with: request)
+          self.aiResponseDelegate.register(task, expectedURL: requestURL) { [weak self] data in
+            guard self != nil,
+                  let data,
+                  data.count <= 65_536,
+                  let candidate = SquirrelAI.parseCandidate(from: data) else { return }
+            DispatchQueue.main.async { [weak self] in
+              self?.applyAICandidate(candidate, snapshot: snapshot, configuration: configuration)
+            }
+          }
+          self.aiTask = task
+          task.resume()
+        }
+      }
+    }
+  }
+
+  func applyAICandidate(
+    _ candidate: String,
+    snapshot: SquirrelAISnapshot,
+    configuration: SquirrelAIRuntimeConfiguration
+  ) {
+    if IsSecureEventInputEnabled() {
+      aiHistory.observeSecureInput()
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    guard ownsAICandidate(snapshot) else { return }
+    guard currentAIRuntimeConfiguration() == configuration else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+    guard session != 0,
+          rimeAPI.find_session(session),
+          currentAISnapshot(generation: snapshot.generation) == snapshot else {
+      invalidateAICandidate(clearProperties: true)
+      return
+    }
+
+    aiTask = nil
+    _ = rimeAPI.set_property(session, "_ai_candidate", candidate)
+    _ = rimeAPI.set_property(session, "_ai_input", snapshot.input)
+    _ = rimeAPI.set_property(session, "_ai_generation", String(snapshot.generation))
+    let refresh = rimeAPI.get_option(session, "_ai_refresh")
+    rimeAPI.set_option(session, "_ai_refresh", !refresh)
+    aiCandidatePublished = true
+    rimeUpdate(scheduleAI: false)
+  }
